# Copy to .env.local and fill in. Never commit .env.local.
# Nothing here is needed to BUILD the app; these are read (and validated) at runtime on first use.
# The full schema, defaults and production checks live in server/env.ts.

# --- Required ---------------------------------------------------------------------------------------------

# MongoDB connection string (local mongod, Docker, or MongoDB Atlas "mongodb+srv://..." URI).
MONGODB_URI=mongodb://127.0.0.1:27017/makeitso

# Secret used to sign session cookies. Generate one with:  openssl rand -base64 32
# In production it must be at least 32 characters and not this placeholder.
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Public URL of the app. Optional on Vercel (detected automatically); set it everywhere else.
NEXTAUTH_URL=http://localhost:3000

# Public origin of the app, checked against the Origin header of every POST/PUT/PATCH/DELETE (CSRF).
# Required in production (not on Vercel preview deployments). Falls back to the NEXTAUTH_URL origin.
APP_ORIGIN=http://localhost:3000

# --- AI (Anthropic Claude) -----------------------------------------------------------------------------------

# API key from https://console.anthropic.com. Only needed for AI features with AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# "anthropic" (default) or "mock" (canned responses for local development and tests; no key needed).
# "mock" is rejected on the Vercel production environment.
AI_PROVIDER=anthropic

# Turn every AI feature off (default: true). AI also needs a verified @davidson.edu account and consent.
AI_ENABLED=true

# Tokens per day across all users before AI pauses ("AI is paused for today"). Default: 2000000.
AI_DAILY_TOKEN_BUDGET=2000000

# --- Mail (Davidson mailbox verification codes) --------------------------------------------------------------

# "none", "console" (prints codes in the server log; not allowed on Vercel production) or "resend".
# Default: "console" in development and tests, "none" in production (alumni + AI stay unavailable).
MAIL_PROVIDER=
# Provider API key and sender, required for "resend", e.g. MAIL_FROM="MakeItSo <noreply@example.org>".
MAIL_API_KEY=
MAIL_FROM=

# --- Jobs and admin ------------------------------------------------------------------------------------------

# Bearer secret Vercel Cron sends to /api/cron/* (at least 16 characters: openssl rand -hex 32).
# Cron routes answer 503 until it is set.
CRON_SECRET=

# Comma-separated e-mail addresses allowed on admin routes (the account also needs a verified mailbox).
ADMIN_EMAILS=

# "live" (default) calls Davidson, RateMyProfessors and the feeds; "fixtures" serves tests/fixtures/external
# instead (tests, e2e and CI use it; rejected on the Vercel production environment).
EXTERNAL_MODE=live

# --- Feature flags (all default on, except RMP summaries) ----------------------------------------------------

FEATURE_CAREERS=true
FEATURE_EVENTS=true
FEATURE_ALUMNI=true

# RateMyProfessors ratings (default: true) and AI summaries of RMP reviews (default: false; owner opt-in only).
RMP_ENABLED=true
RMP_SUMMARIES_ENABLED=false

# --- Optional ------------------------------------------------------------------------------------------------

# Time zone for all "today"/"now" logic (IANA name). Default: America/New_York.
APP_TIMEZONE=America/New_York
