# Copy to .env.local and fill in. Never commit .env.local.
# Nothing here is needed to BUILD the app; these are read (and validated) at runtime on first use.
# The full schema lives in server/env.ts.

# --- Required ---------------------------------------------------------------------------------------------

# MongoDB connection string (local mongod, Docker, or MongoDB Atlas "mongodb+srv://..." URI).
MONGODB_URI=mongodb://127.0.0.1:27017/makeitso

# Secret used to sign session cookies. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the app. Optional on Vercel (detected automatically); set it everywhere else.
NEXTAUTH_URL=http://localhost:3000

# --- AI (Anthropic Claude) -----------------------------------------------------------------------------------

# API key from https://console.anthropic.com. Only needed for AI features with AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# "anthropic" (default) or "mock" (canned responses for local development and tests; no key needed).
AI_PROVIDER=anthropic

# --- Optional ------------------------------------------------------------------------------------------------

# Time zone for all "today"/"now" logic (IANA name). Default: America/New_York.
APP_TIMEZONE=America/New_York

# RateMyProfessors ratings (default: true) and AI summaries of RMP reviews (default: false; owner opt-in only).
RMP_ENABLED=true
RMP_SUMMARIES_ENABLED=false
